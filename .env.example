# Identificação exigida pela política do Nominatim (use um e-mail real do responsável)
VITE_GEOCODER_EMAIL=
# Para sugestões ao digitar, use instância PRÓPRIA (o servidor público proíbe autocomplete).
# Vazio/ausente = https://nominatim.openstreetmap.org (sem barra no final; aceita caminho, ex.: /geocode).
# VITE_GEOCODER_URL=https://geocoder.suaempresa.com
# VITE_GEOCODER_AUTOCOMPLETE=true
# Fonte dos pontos (padrão: /data/pontos-coleta.json). Troque por uma API quando houver banco.
# VITE_PONTOS_URL=/api/pontos-coleta
